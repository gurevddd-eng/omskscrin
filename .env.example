# Скопируйте в .env в корне репозитория и заполните под площадку.
# cp .env.example .env

# development | production
NODE_ENV=production

# PostgreSQL (локальная установка, без Docker)
DATABASE_URL=postgresql://stella:CHANGE_ME@127.0.0.1:5432/stella

# Обязательно смените в production (длинная случайная строка)
JWT_SECRET=CHANGE_ME_TO_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=12h

# Учётка первого admin (только для pnpm db:seed)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

PORT=8080
HOST=0.0.0.0

# Каталог медиафайлов (относительно корня репозитория, либо абсолютный путь)
MEDIA_DIR=./data/media

# Собранная админка (по умолчанию apps/admin/dist). SERVE_ADMIN=0 — только API
# ADMIN_DIST=./apps/admin/dist
# SERVE_ADMIN=1

# CORS: пусто = разрешить все (удобно в LAN). Киоск UI (127.0.0.1:47820) разрешён всегда в коде.
# Для dev-админки можно указать: http://localhost:5173,http://localhost:5174
CORS_ORIGIN=

# Опрос киосков
PROBE_INTERVAL_MS=30000
PROBE_TIMEOUT_MS=2500

# Публичный URL API, который прописывается в kiosk.json на киосках
SERVER_PUBLIC_URL=http://192.168.1.10:8080

# Удалённая установка софта с Debian-сервера на Windows-киоски.
# Domain account. Prefer UPN: user@domain.local
DEPLOY_USER=gdv@udhb.local
DEPLOY_PASSWORD=change-me
# Also ok: udhb.local\\gdv  (in .env write as udhb.local\\\\gdv or use UPN above)
# DEPLOY_PACKAGE_DIR=./data/deploy/current

# Транспорт: auto | winrm | ssh
# auto на Debian: pwsh+WinRM если есть, иначе SSH (OpenSSH на киосках)
# Рекомендуется для Debian без PowerShell:
# DEPLOY_TRANSPORT=ssh
DEPLOY_TRANSPORT=auto

# Явный путь к pwsh (Linux): /usr/bin/pwsh
# DEPLOY_POWERSHELL=/usr/bin/pwsh

# SSH (если DEPLOY_TRANSPORT=ssh): порт и ключ вместо пароля
# DEPLOY_SSH_PORT=22
# DEPLOY_SSH_KEY_PATH=/home/stella/.ssh/id_rsa
